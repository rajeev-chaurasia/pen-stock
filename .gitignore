# Built binaries. Anchored on purpose: a bare "penstock" pattern also
# matches the cmd/penstock directory and would quietly stop new source
# files there from being committed.
/penstock
/penstock.exe
/llmsim
/llmsim.exe
/cmd/penstock/penstock
/cmd/llmsim/llmsim
*.exe
/bin/
/dist/

# test and coverage artifacts
coverage.out
coverage.html
*.test

# local environment. The example carries names only and is committed on
# purpose; anything else matching these patterns holds real keys.
.env
.env.*
!.env.example

# operator config, which resolves real keys at load time
/config.yaml

# editor noise
.idea/
.vscode/
*.swp
.DS_Store
