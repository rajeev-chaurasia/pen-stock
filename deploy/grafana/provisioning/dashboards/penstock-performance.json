{
  "uid": "penstock-performance",
  "title": "Penstock performance",
  "description": "Throughput, latency, and failure shape for the gateway and the providers behind it. Cost tells you what a deployment is worth; this tells you whether it is working.",
  "tags": ["penstock", "performance"],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "description": "The upstream that answered. On a fallback chain this is not necessarily the provider the route names first.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(penstock_requests_total, provider)",
        "query": {
          "qryType": 1,
          "query": "label_values(penstock_requests_total, provider)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "options": [],
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "path",
        "label": "Path",
        "description": "Paths are normalized to a fixed set before they become labels, so an unrecognized URL lands under 'other' instead of minting cardinality. Narrow this to /v1/chat/completions when health probes are drowning out real traffic.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(penstock_requests_total, path)",
        "query": {
          "qryType": 1,
          "query": "label_values(penstock_requests_total, path)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "options": [],
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "Requests per second across the current selection. Useful mostly as a denominator: every other number on this dashboard means something different at 0.1 requests per second than at 100.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 request duration",
      "description": "The 95th percentile end to end duration, gateway edge to gateway edge. Streaming and non-streaming requests are pooled here, so on a stream-heavy deployment this number is dominated by how long answers take to finish rather than by how quickly they start. Watch time to first token below for the number a user actually feels.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(penstock_request_duration_seconds_bucket{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx share of requests",
      "description": "The fraction of requests answered with a server error. Healthy is zero and stays zero: a gateway that shrugs off upstream failures should be turning them into fallbacks, not into 5xx. Reads as No data when nothing is flowing, because the ratio has no denominator then, and that is deliberate: a fabricated zero would look like health.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "5xx share",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\", code=~\"5..\"}[$__rate_interval])) / sum(rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by status code",
      "description": "Every answer the gateway gave, stacked by status code. The healthy shape is a solid band of 200 with nothing meaningful above it. The interesting codes are specific: 402 is a tenant out of budget, 429 is a tenant over its rate limit, 503 is either load shedding at max_inflight or a fail-closed tenant whose accounting store went blind. 401 arriving in volume means a client shipped with the wrong key, and it is worth catching because those requests are free to refuse but not free to serve.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate by provider",
      "description": "Server errors as a share of each provider's own traffic, so a provider serving a hundred requests is not compared against one serving two. Only 5xx counts here: a 402 or a 429 is the gateway working correctly and belongs on the cost dashboard's denial panel, not in an error budget. Healthy is a flat line on zero. One provider lifting off the floor while the others stay flat is the signal a fallback chain exists to absorb, and if the chain is doing its job you will see this rise without the top level 5xx share moving at all.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\", code=~\"5..\"}[$__rate_interval])) / sum by (provider) (rate(penstock_requests_total{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request duration p50 / p95 / p99",
      "description": "End to end duration quantiles, computed from the histogram buckets rather than from an average, because an average latency over a mix of cache-fast and minute-long completions describes no request that ever happened. The healthy shape is three roughly parallel lines. p50 rising means everything got slower. p99 pulling away from p50 while p50 holds means a tail appeared, which is usually one provider, one long prompt shape, or a retry being served in place. The buckets top out at 120 seconds, so a p99 pinned at that ceiling means requests are running past the last bucket and the true value is unknown rather than 120.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(penstock_request_duration_seconds_bucket{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(penstock_request_duration_seconds_bucket{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(penstock_request_duration_seconds_bucket{provider=~\"$provider\", path=~\"$path\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time to first token p50 / p95 / p99 by provider",
      "description": "How long a streaming caller waits before anything appears on screen. This is the latency number a human notices, and it is the one worth routing on: a provider with a slow total duration but a fast first token feels responsive, and the reverse feels broken. Healthy is sub-second p50 with p99 inside a couple of seconds. A provider whose p99 climbs while the others hold is queueing you, which is what a free tier does before it starts refusing outright. There is no path filter here because the metric carries only a provider label, so the Path variable does not apply to this panel.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p50"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [8, 4]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{provider}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(penstock_ttft_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{provider}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(penstock_ttft_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{provider}} p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(penstock_ttft_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens per second by direction",
      "description": "Throughput in the unit providers actually bill in. Prompt tokens are what callers send, completion tokens are what providers generate, and reasoning tokens are counted as completion because that is how they are charged. The ratio between the two lines is the shape of the workload: a retrieval-heavy application runs prompt-dominant, a drafting tool runs completion-dominant. A sudden swing toward prompt with no change in request rate usually means somebody started stuffing context, and it will show up on the cost dashboard a few minutes later.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tok/s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (direction) (rate(penstock_tokens_total{provider=~\"$provider\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "hide": true,
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{provider}} {{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, direction) (rate(penstock_tokens_total{provider=~\"$provider\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
