# binaries, wherever a build happens to drop them
penstock
penstock.exe
llmsim
llmsim.exe
*.exe
/bin/
/dist/

# test and coverage artifacts
coverage.out
coverage.html
*.test

# local environment. The example carries names only and is committed on
# purpose; anything else matching these patterns holds real keys.
.env
.env.*
!.env.example

# operator config, which resolves real keys at load time
/config.yaml

# editor noise
.idea/
.vscode/
*.swp
.DS_Store
