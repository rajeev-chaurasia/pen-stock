# Penstock environment template. Copy to .env and fill in what you have.
#
#   cp .env.example .env
#
# .env is gitignored and dockerignored; this file carries names only and
# never values. Penstock reads these at load time through the ${VAR}
# references in config.yaml, so no key is ever written into config.
#
# Load them into your shell before starting the gateway:
#
#   set -a; . ./.env; set +a
#
# You do not need all of these. Any provider you leave blank should stay
# commented out in config.yaml, because an empty variable fails the load
# on purpose rather than booting a gateway whose calls all return 401.

# --- Free tiers, no credit card ------------------------------------------
# Google AI Studio: aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: console.groq.com/keys
GROQ_API_KEY=

# Cerebras: cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter: openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral: console.mistral.ai
# The large free allowance requires opting into training on your prompts,
# so keep real data away from this one.
MISTRAL_API_KEY=

# --- Paid, no free tier --------------------------------------------------
# Leave blank unless you have credits. The adapters are covered by the
# conformance suite either way; they just will not be exercised live.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- The gateway's own client keys ---------------------------------------
# What callers present as "Authorization: Bearer <key>". These guard the
# provider keys above, so treat them as secrets too. Generate one with:
#
#   openssl rand -hex 32
#
PENSTOCK_CLIENT_KEY=
